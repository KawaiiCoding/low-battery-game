{
  "name": "low-battery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.2.5",
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.4"
  }
}
